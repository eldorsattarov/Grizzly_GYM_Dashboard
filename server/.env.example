# Server porti
PORT=4000

# ⚠️ MAJBURIY — bo'sh qoldirmang!
#
# Bu kalit kirish tokenlarini imzolaydi. Uni bilgan odam
# istalgan hisobga kira oladi, shuning uchun HAR BIR SERVER
# uchun yangisini yarating:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Chiqqan matnni pastdagi qatorga qo'ying.
# Kalit yozilmasa yoki qisqa bo'lsa server ishga tushmaydi.

JWT_SECRET=

# Ruxsat berilgan manzillar (vergul bilan ajrating).
# Landing va boshqaruv turli domenlarda bo'lsa ikkalasini ham yozing:
#   CORS_ORIGIN=https://grizzlygym.uz,https://admin.grizzlygym.uz
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Ma'lumotlar bazasi fayli.
# Serverda loyihadan tashqarida saqlang, masalan:
#   DB_FILE=/home/grizzly/app/grizzly.db
DB_FILE=./grizzly.db
